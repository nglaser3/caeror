{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CAEROR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "cov",
      "inherits":"base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CAEROR_GENERATE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "cov",
      "configurePreset": "cov"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true,
        "shortProgress": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true,
        "shortProgress": true
      },
      "execution": {
        "noTestsAction": "error",
        "parallelLevel":0
      }
    },
    {
      "name": "cov",
      "configurePreset": "cov",
      "execution": {
        "parallelLevel":0
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "steps": [
        {"type": "configure", "name": "release"},
        {"type": "build", "name": "release"}
      ]
    },
    {
      "name": "ci",
      "steps": [
        {"type": "configure", "name": "release"},
        {"type": "build", "name": "release"},
        {"type": "test", "name": "ci"}
      ]
    },
    {
      "name": "cov-gcc",
      "steps": [
        { "type": "configure", "name": "cov" },
        { "type": "build",     "name": "cov" },
        { "type": "test",      "name": "cov" }
      ]
    }
  ]
}
